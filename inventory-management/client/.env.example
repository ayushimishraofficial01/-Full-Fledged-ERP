# Leave empty when the API is served from the same domain (recommended; e.g. /api behind Nginx
# or SERVE_CLIENT=true on the server). Set to the API origin when hosted separately,
# e.g. https://api.example.com  (then set COOKIE_SAMESITE=none and COOKIE_SECURE=true on the server)
VITE_API_URL=

# Google Sign-In: the same OAuth 2.0 Web client ID you put in the server's GOOGLE_CLIENT_ID (leave empty to disable)
VITE_GOOGLE_CLIENT_ID=
