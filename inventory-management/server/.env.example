# ---- Required ----
NODE_ENV=development
PORT=5000
# Local:  mongodb://127.0.0.1:27017/inventory_management
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/inventory_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/inventory_management
# Long random string, at least 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated list of allowed frontend origins (first one is used in reset-password emails)
CLIENT_URL=http://localhost:5173

# ---- Optional ----
JWT_EXPIRES_IN=7d
COOKIE_NAME=ims_token
# lax (same site) | none (frontend and API on different domains, requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Set to false after creating your accounts to stop public sign-ups
ALLOW_REGISTRATION=true
# Google Sign-In: paste the OAuth 2.0 Web client ID from Google Cloud Console (leave empty to disable)
# Add your frontend origin (e.g. http://localhost:5173) under "Authorized JavaScript origins" there.
GOOGLE_CLIENT_ID=
# auto = use MongoDB transactions when the server is a replica set (Atlas always is)
USE_TRANSACTIONS=auto
APP_TIMEZONE=Asia/Kolkata
MAX_IMAGE_SIZE_MB=2
MAX_IMPORT_SIZE_MB=10
MAX_IMPORT_ROWS=10000
MAX_EXPORT_ROWS=50000
UPLOAD_DIR=uploads
# Serve client/dist from this server (single-origin deployment)
SERVE_CLIENT=false
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
TRUST_PROXY=

# ---- Email (password reset, attendance, and HR notifications) ----
# SMTP_HOST is required for email delivery; in-app notifications remain available without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gen Vyro <no-reply@example.com>
